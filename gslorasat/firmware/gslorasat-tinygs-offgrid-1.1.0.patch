diff --git a/tinyGS/src/GpsBridge.h b/tinyGS/src/GpsBridge.h
new file mode 100644
index 0000000..a5fa7c7
--- /dev/null
+++ b/tinyGS/src/GpsBridge.h
@@ -0,0 +1,174 @@
+/*
+  GpsBridge.h - Lecture du GPS (NEO-6M) du T-Beam et emission @GPS (off-grid).
+
+  Actif seulement si OFFGRID_HAS_GPS est defini (env T-Beam). Le GPS est sur une
+  UART materielle (Serial1, broches GPS_RX_PIN/GPS_TX_PIN) et alimente par le
+  LDO3 de l'AXP192 : on force cette alim au demarrage sans dependre de la
+  detection du chip (qui echoue sur certaines cartes).
+
+  Emet periodiquement sur le port USB :
+    @GPS {"lat":48.41,"lon":2.75,"alt":120,"sats":7,"fix":true,"time":"2026-07-13T16:03:08Z"}
+  que GSLoraSat utilise pour la position/heure du mode automatique.
+*/
+#ifndef GPS_BRIDGE_H
+#define GPS_BRIDGE_H
+#ifdef OFFGRID_HAS_GPS
+
+#include <Arduino.h>
+#include <Wire.h>
+#include <time.h>
+#include <sys/time.h>
+#include "SerialBridge.h"
+
+#ifndef GPS_RX_PIN
+#define GPS_RX_PIN 34      // ESP32 recoit les donnees du GPS (T-Beam v1.1)
+#endif
+#ifndef GPS_TX_PIN
+#define GPS_TX_PIN 12      // ESP32 vers GPS (config, optionnel)
+#endif
+#ifndef GPS_BAUD
+#define GPS_BAUD 9600
+#endif
+#ifndef GPS_EMIT_MS
+#define GPS_EMIT_MS 10000  // frequence d'emission @GPS
+#endif
+
+namespace GpsBridge {
+
+  inline HardwareSerial& port() { return Serial1; }   // UART1 de l'ESP32
+
+  static String  _line;
+  static double  _lat = 0, _lon = 0, _alt = 0;
+  static int     _sats = 0;
+  static bool    _fix = false;
+  static char    _date[7] = "";   // ddmmyy (RMC)
+  static char    _time[7] = "";   // hhmmss (RMC/GGA)
+  static unsigned long _lastEmit = 0;
+
+  // --- Force l'alim des rails LoRa (LDO2) + GPS (LDO3) via l'AXP192 @0x34 ---
+  inline void powerRails() {
+    Wire.begin(21, 22);
+    // LDO2/LDO3 = 3.3V (reg 0x28 : nibble haut LDO2, bas LDO3 ; 0xFF -> 3.3V)
+    Wire.beginTransmission(0x34); Wire.write(0x28); Wire.write(0xFF); Wire.endTransmission();
+    // Power output control (reg 0x12) : activer bit2 (LDO2) + bit3 (LDO3)
+    Wire.beginTransmission(0x34); Wire.write(0x12); Wire.endTransmission();
+    Wire.requestFrom(0x34, 1);
+    uint8_t v = Wire.available() ? Wire.read() : 0;
+    v |= 0x0C;
+    Wire.beginTransmission(0x34); Wire.write(0x12); Wire.write(v); Wire.endTransmission();
+  }
+
+  inline void begin() {
+    powerRails();
+    port().begin(GPS_BAUD, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
+    Serial.println(F("@LOG GPS T-Beam initialise (LDO3 force, Serial1)"));
+  }
+
+  // Recupere le champ n (0-based) d'une trame NMEA separee par des virgules.
+  inline String field(const String& s, int n) {
+    int start = 0, idx = 0;
+    while (idx < n) {
+      start = s.indexOf(',', start);
+      if (start < 0) return "";
+      start++; idx++;
+    }
+    int end = s.indexOf(',', start);
+    if (end < 0) end = s.length();
+    return s.substring(start, end);
+  }
+
+  // "ddmm.mmmm" + hemisphere -> degres decimaux
+  inline double toDeg(const String& v, const String& hemi) {
+    if (v.length() < 4) return 0;
+    int dot = v.indexOf('.');
+    int degLen = (dot >= 0 ? dot : (int)v.length()) - 2;
+    if (degLen < 1) return 0;
+    double deg = v.substring(0, degLen).toDouble();
+    double minutes = v.substring(degLen).toDouble();
+    double d = deg + minutes / 60.0;
+    if (hemi == "S" || hemi == "W") d = -d;
+    return d;
+  }
+
+  inline void parse(const String& s) {
+    if (s.startsWith("$G") && s.indexOf("RMC") == 3) {
+      // $xxRMC,time,status,lat,N,lon,E,speed,course,date,...
+      String st = field(s, 2);
+      _fix = (st == "A");
+      if (_fix) {
+        _lat = toDeg(field(s, 3), field(s, 4));
+        _lon = toDeg(field(s, 5), field(s, 6));
+        strncpy(_time, field(s, 1).c_str(), 6); _time[6] = '\0';
+        strncpy(_date, field(s, 9).c_str(), 6); _date[6] = '\0';
+      }
+    } else if (s.startsWith("$G") && s.indexOf("GGA") == 3) {
+      // $xxGGA,time,lat,N,lon,E,q,sats,hdop,alt,M,...
+      int q = field(s, 6).toInt();
+      _sats = field(s, 7).toInt();
+      _alt = field(s, 9).toDouble();
+      if (q > 0 && !_fix) {   // GGA confirme un fix si RMC pas encore vu
+        _lat = toDeg(field(s, 2), field(s, 3));
+        _lon = toDeg(field(s, 4), field(s, 5));
+        _fix = true;
+      }
+    }
+  }
+
+  // Cale l'horloge systeme (UTC) sur l'heure GPS -> time(NULL) correct pour
+  // l'overlay OLED et les calculs de position.
+  inline void syncClock() {
+    if (strlen(_date) != 6 || strlen(_time) < 6) return;
+    static bool tz_done = false;
+    if (!tz_done) { setenv("TZ", "UTC0", 1); tzset(); tz_done = true; }
+    struct tm tmv; memset(&tmv, 0, sizeof(tmv));
+    tmv.tm_mday = (_date[0]-'0')*10 + (_date[1]-'0');
+    tmv.tm_mon  = (_date[2]-'0')*10 + (_date[3]-'0') - 1;
+    tmv.tm_year = 100 + (_date[4]-'0')*10 + (_date[5]-'0');   // 20yy
+    tmv.tm_hour = (_time[0]-'0')*10 + (_time[1]-'0');
+    tmv.tm_min  = (_time[2]-'0')*10 + (_time[3]-'0');
+    tmv.tm_sec  = (_time[4]-'0')*10 + (_time[5]-'0');
+    time_t epoch = mktime(&tmv);
+    if (epoch > 1735689600) {   // > 2025-01-01 : garde-fou
+      struct timeval tv; tv.tv_sec = epoch; tv.tv_usec = 0;
+      settimeofday(&tv, nullptr);
+    }
+  }
+
+  inline void emit() {
+    // Construit l'heure ISO a partir de date(ddmmyy)+time(hhmmss) du GPS
+    char iso[25] = "";
+    if (strlen(_date) == 6 && strlen(_time) >= 6) {
+      snprintf(iso, sizeof(iso), "20%c%c-%c%c-%c%cT%c%c:%c%c:%c%cZ",
+               _date[4], _date[5], _date[2], _date[3], _date[0], _date[1],
+               _time[0], _time[1], _time[2], _time[3], _time[4], _time[5]);
+    }
+    // Ligne construite en memoire puis emise d'un bloc (anti-entrelacement
+    // avec le logger asynchrone) sur l'USB ET le client TCP Wi-Fi.
+    String out = F("@GPS {\"lat\":");  out += String(_lat, 5);
+    out += F(",\"lon\":");             out += String(_lon, 5);
+    out += F(",\"alt\":");             out += String(_alt, 0);
+    out += F(",\"sats\":");            out += _sats;
+    out += F(",\"fix\":true,\"time\":\"");
+    out += iso;
+    out += F("\"}");
+    SerialBridge::emitLine(out);
+  }
+
+  inline void loop() {
+    HardwareSerial& g = port();
+    while (g.available()) {
+      char c = (char) g.read();
+      if (c == '\n') { parse(_line); _line = ""; }
+      else if (c != '\r') { _line += c; if (_line.length() > 120) _line = ""; }
+    }
+    if (_fix && millis() - _lastEmit > GPS_EMIT_MS) {
+      _lastEmit = millis();
+      syncClock();
+      emit();
+    }
+  }
+
+} // namespace GpsBridge
+
+#endif // OFFGRID_HAS_GPS
+#endif // GPS_BRIDGE_H
