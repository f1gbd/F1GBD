diff --git a/tinyGS/src/NetBridge.h b/tinyGS/src/NetBridge.h
new file mode 100644
index 0000000..855e7af
--- /dev/null
+++ b/tinyGS/src/NetBridge.h
@@ -0,0 +1,101 @@
+/*
+  NetBridge.h - Pont TCP Wi-Fi du protocole GSLoRaSAT (meme protocole que l'USB)
+  ------------------------------------------------------------------------------
+  GSLoRaSAT firmware off-grid (T-Beam / Heltec V3) - F1GBD / ADRASEC 77
+
+  La station TinyGS ouvre deja un point d'acces Wi-Fi (IotWebConf) dont le SSID
+  est le NOM DE LA STATION (ex. "F1GBD-GeoVOR", reglable par !CFG {"name":..}),
+  adresse 192.168.4.1. NetBridge y ajoute un serveur TCP (port GSL_TCP_PORT,
+  8023 par defaut) qui transporte EXACTEMENT le protocole ligne-a-ligne du port
+  serie : @RX/@ST/@HELLO/@ACK/@LOG/@GPS/@LOG* vers le PC, !CMD vers la station.
+
+  Un seul client a la fois (le dernier connecte remplace le precedent). Les
+  lignes @RX/@GPS sont diffusees sur l'USB ET le TCP ; les reponses a une
+  commande ne partent que vers le canal qui l'a envoyee.
+
+  Le serveur n'est demarre qu'une fois la pile Wi-Fi active (WiFi.getMode() !=
+  WIFI_OFF) : appeler service() a chaque tour de loop().
+*/
+#ifndef NET_BRIDGE_H
+#define NET_BRIDGE_H
+
+#include <Arduino.h>
+#include <WiFi.h>
+
+#ifndef GSL_TCP_PORT
+#define GSL_TCP_PORT 8023
+#endif
+
+namespace NetBridge {
+
+  struct State {
+    WiFiServer* srv = nullptr;
+    WiFiClient  cli;
+    String      buf;
+    bool        fresh = false;   // client tout juste connecte (-> @HELLO)
+  };
+  inline State& st() { static State s; return s; }
+
+  inline bool connected() {
+    State& s = st();
+    return s.srv && s.cli && s.cli.connected();
+  }
+
+  inline bool listening() { return st().srv != nullptr; }
+
+  inline void write(const String& line) {          // line inclut deja le '\n'
+    if (!connected()) return;
+    st().cli.write((const uint8_t*)line.c_str(), line.length());
+  }
+
+  // Adresse a annoncer : AP de la station sinon IP du reseau rejoint.
+  inline String ip() {
+    wifi_mode_t m = WiFi.getMode();
+    if (m == WIFI_MODE_AP || m == WIFI_MODE_APSTA) return WiFi.softAPIP().toString();
+    if (m == WIFI_MODE_STA) return WiFi.localIP().toString();
+    return String("");
+  }
+
+  inline void service() {
+    State& s = st();
+    if (!s.srv) {
+      if (WiFi.getMode() == WIFI_MODE_NULL) return;  // pile Wi-Fi pas encore lancee
+      s.srv = new WiFiServer(GSL_TCP_PORT, 1);
+      s.srv->begin();
+      s.srv->setNoDelay(true);
+      Serial.println(F("@LOG NetBridge : serveur TCP actif"));
+    }
+    WiFiClient n = s.srv->available();
+    if (n) {
+      if (s.cli) s.cli.stop();
+      s.cli = n;
+      s.cli.setNoDelay(true);
+      s.buf = "";
+      s.fresh = true;
+    }
+    if (s.cli && !s.cli.connected()) s.cli.stop();
+  }
+
+  // Rend true quand une ligne complete (sans \r\n) est disponible dans out.
+  inline bool readLine(String& out) {
+    State& s = st();
+    if (!connected()) return false;
+    while (s.cli.available()) {
+      char c = (char)s.cli.read();
+      if (c == '\n') { out = s.buf; s.buf = ""; out.trim(); return true; }
+      if (c != '\r') {
+        s.buf += c;
+        if (s.buf.length() > 700) s.buf = "";       // garde-fou
+      }
+    }
+    return false;
+  }
+
+  inline bool takeFresh() {
+    State& s = st();
+    if (s.fresh && connected()) { s.fresh = false; return true; }
+    return false;
+  }
+
+} // namespace NetBridge
+#endif
diff --git a/tinyGS/src/PacketStore.h b/tinyGS/src/PacketStore.h
new file mode 100644
index 0000000..ea9c0d9
--- /dev/null
+++ b/tinyGS/src/PacketStore.h
@@ -0,0 +1,162 @@
+/*
+  PacketStore.h - Journal des paquets satellites dans la flash de la station
+  ---------------------------------------------------------------------------
+  GSLoRaSAT firmware off-grid (T-Beam / Heltec V3) - F1GBD / ADRASEC 77
+
+  Chaque paquet VALIDE (crc_error == false) recu par la station est ecrit, sous
+  la forme exacte de la ligne @RX (document JSON), dans la partition "spiffs"
+  de la flash (512 Ko, formatee en LittleFS au premier demarrage). La station
+  garde ainsi ses receptions quand aucun PC n'est branche : GSLoRaSAT ou GeoVOR
+  les recuperent plus tard, a la demande (!LOGDUMP), par l'USB ou le Wi-Fi.
+
+  Rotation : deux fichiers /gsl_rx.old + /gsl_rx.log de GSL_STORE_MAX_FILE
+  chacun au plus. Quand le fichier courant est plein, l'ancien est supprime et
+  le courant devient l'ancien : on garde toujours les paquets les plus recents
+  (~ 600 a 900 paquets selon la taille des charges utiles).
+
+  Identite d'un paquet : (boot, seq).
+    seq  : compteur croissant, persistant (NVS), jamais remis a zero sauf
+           effacement de la NVS. Permet une recuperation INCREMENTALE
+           (!LOGDUMP <seq> ne renvoie que les paquets seq >= <seq>).
+    boot : numero de demarrage de la station (NVS). Un paquet du boot courant
+           peut etre redate cote PC grace a up_ms (millis() a la reception),
+           meme quand l'horloge de la station n'a jamais ete calee.
+  Ces trois champs (seq, boot, up_ms) sont aussi ajoutes aux lignes @RX
+  emises en direct : le PC deduplique alors direct et relecture.
+*/
+#ifndef PACKET_STORE_H
+#define PACKET_STORE_H
+
+#include <Arduino.h>
+#include <FS.h>
+#include <LittleFS.h>
+#include <Preferences.h>
+
+#ifndef GSL_STORE_MAX_FILE
+#define GSL_STORE_MAX_FILE (200UL * 1024UL)   // 2 x 200 Ko dans 512 Ko
+#endif
+
+namespace PacketStore {
+
+  static const char* const F_CUR = "/gsl_rx.log";
+  static const char* const F_OLD = "/gsl_rx.old";
+
+  struct State {
+    bool     tried   = false;
+    bool     ok      = false;
+    uint32_t seq     = 0;     // prochain numero a attribuer
+    uint32_t boot    = 0;     // numero du demarrage courant
+    uint32_t nCur    = 0;     // paquets dans F_CUR
+    uint32_t nOld    = 0;     // paquets dans F_OLD
+    uint32_t firstSeq = 0;    // plus ancien seq encore stocke (0 = inconnu)
+  };
+
+  // Etat UNIQUE pour tout le firmware : fonction inline (liaison externe) ->
+  // une seule variable statique, meme si l'en-tete est inclus par plusieurs
+  // unites de compilation (tinyGS.ino ET MQTT_Client.cpp).
+  inline State& st() { static State s; return s; }
+
+  // Compte les lignes d'un fichier et rend le seq de la premiere.
+  inline uint32_t countLines(const char* path, uint32_t* firstSeq) {
+    File f = LittleFS.open(path, "r");
+    if (!f) return 0;
+    uint32_t n = 0;
+    uint8_t buf[256];
+    bool first = true;
+    String head;
+    while (f.available()) {
+      int r = f.read(buf, sizeof(buf));
+      if (r <= 0) break;
+      for (int i = 0; i < r; i++) {
+        if (first && head.length() < 120) head += (char)buf[i];
+        if (buf[i] == '\n') { n++; first = false; }
+      }
+    }
+    f.close();
+    if (firstSeq) {
+      int p = head.indexOf("\"seq\":");
+      *firstSeq = (p >= 0) ? (uint32_t)head.substring(p + 6).toInt() : 0;
+    }
+    return n;
+  }
+
+  inline bool begin() {
+    State& s = st();
+    if (s.tried) return s.ok;
+    s.tried = true;
+
+    Preferences p;
+    if (p.begin("gslstore", false)) {
+      s.seq  = p.getUInt("seq", 1);
+      s.boot = p.getUInt("boot", 0) + 1;
+      p.putUInt("boot", s.boot);
+      p.end();
+    }
+    // Partition "spiffs" de tinygs_4M_partition_table.csv, formatee au besoin.
+    s.ok = LittleFS.begin(true, "/littlefs", 4, "spiffs");
+    if (s.ok) {
+      uint32_t fo = 0, fc = 0;
+      s.nOld = countLines(F_OLD, &fo);
+      s.nCur = countLines(F_CUR, &fc);
+      s.firstSeq = s.nOld ? fo : fc;
+    }
+    return s.ok;
+  }
+
+  inline bool     ready()    { return st().ok; }
+  inline uint32_t count()    { return st().nCur + st().nOld; }
+  inline uint32_t bootId()   { return st().boot; }
+  inline uint32_t lastSeq()  { return st().seq > 0 ? st().seq - 1 : 0; }
+  inline uint32_t firstSeq() { return st().firstSeq; }
+
+  // Attribue le numero du prochain paquet (persistant).
+  inline uint32_t nextSeq() {
+    State& s = st();
+    uint32_t n = s.seq++;
+    Preferences p;
+    if (p.begin("gslstore", false)) { p.putUInt("seq", s.seq); p.end(); }
+    return n;
+  }
+
+  // Ajoute une ligne JSON (sans prefixe, sans '\n').
+  inline void append(const String& json, uint32_t seq) {
+    State& s = st();
+    if (!s.ok) return;
+    size_t len = json.length() + 1;
+    size_t cur = 0;
+    if (LittleFS.exists(F_CUR)) {
+      File c = LittleFS.open(F_CUR, "r");
+      if (c) { cur = c.size(); c.close(); }
+    }
+    if (cur + len > GSL_STORE_MAX_FILE) {          // rotation
+      if (LittleFS.exists(F_OLD)) LittleFS.remove(F_OLD);
+      LittleFS.rename(F_CUR, F_OLD);
+      s.nOld = s.nCur;
+      s.nCur = 0;
+      uint32_t fo = 0;
+      countLines(F_OLD, &fo);
+      s.firstSeq = fo;
+    }
+    File f = LittleFS.open(F_CUR, "a");
+    if (!f) return;
+    f.print(json);
+    f.print('\n');
+    f.close();
+    s.nCur++;
+    if (s.firstSeq == 0) s.firstSeq = seq;
+  }
+
+  inline void clear() {
+    State& s = st();
+    if (!s.ok) return;
+    if (LittleFS.exists(F_OLD)) LittleFS.remove(F_OLD);
+    if (LittleFS.exists(F_CUR)) LittleFS.remove(F_CUR);
+    s.nCur = s.nOld = 0;
+    s.firstSeq = 0;
+  }
+
+  inline size_t fsTotal() { return st().ok ? LittleFS.totalBytes() : 0; }
+  inline size_t fsUsed()  { return st().ok ? LittleFS.usedBytes()  : 0; }
+
+} // namespace PacketStore
+#endif
diff --git a/tinyGS/src/SerialBridge.h b/tinyGS/src/SerialBridge.h
new file mode 100644
index 0000000..13169dd
--- /dev/null
+++ b/tinyGS/src/SerialBridge.h
@@ -0,0 +1,521 @@
+/*
+  SerialBridge.h - Pont serie off-grid pour GSLoraSat
+  ---------------------------------------------------
+  Ajoute au firmware TinyGS pour emettre les paquets recus sur l'USB serie ET
+  recevoir les commandes de l'application GSLoraSat, SANS serveur MQTT/OTP.
+
+  Station (ESP32) -> App :  @RX / @ST / @HELLO / @ACK / @LOG
+                            @LOGINFO / @LOGBEGIN / @LOGREC / @LOGEND  (journal)
+  App -> Station          :  !TX / !TUNE / !SAT / !FREQ / !CFG / !MAP / !PING
+                            !LOGINFO / !LOGDUMP [seq] / !LOGSTOP / !LOGCLR
+
+  GSL_FW_VERSION 1.1.0 (04/10/2026) :
+    - journal des paquets valides dans la flash (PacketStore.h), recuperable a
+      la demande par !LOGDUMP, y compris de facon incrementale ;
+    - meme protocole sur un serveur TCP Wi-Fi (NetBridge.h, port 8023) via le
+      point d'acces de la station (SSID = nom de station, 192.168.4.1) ;
+    - champs seq / boot / up_ms dans chaque @RX (dedoublonnage direct/relecture,
+      redatation des paquets d'une station sans horloge) ;
+    - les reponses a une commande ne partent que vers le canal demandeur.
+
+  handleTune() reconfigure DIRECTEMENT la radio (meme logique que la commande
+  MQTT "begin") : il appelle radio.begin(), donc le menu Satellites de l'app
+  pilote reellement la frequence d'ecoute, hors ligne.
+
+  Integration : voir firmware/OFFGRID_FIRMWARE.md
+    - #define OFFGRID_MODE (via build_flags -D OFFGRID_MODE)
+    - setup() : SerialBridge::begin();
+    - loop()  : SerialBridge::loop();   (SEUL lecteur serie)
+    - MQTT_Client::queueRx() : SerialBridge::sendRx(packet);  (emission des @RX)
+*/
+#ifndef SERIAL_BRIDGE_H
+#define SERIAL_BRIDGE_H
+
+#include <Arduino.h>
+#include "ArduinoJson.h"
+#include "Status.h"
+#include "Radio/Radio.h"
+#include "ConfigManager/ConfigManager.h"
+#include "PacketStore.h"
+#include "NetBridge.h"
+
+#ifndef GSL_FW_VERSION
+#define GSL_FW_VERSION "1.1.0"
+#endif
+
+extern Status status;
+
+namespace SerialBridge {
+
+  static String rxLine;
+
+  // --------------------------------------------------------------------
+  //  Canaux de sortie : USB serie, client TCP Wi-Fi, ou les deux.
+  // --------------------------------------------------------------------
+  enum : uint8_t { SINK_ALL = 0, SINK_SERIAL = 1, SINK_TCP = 2 };
+
+  // Canal d'origine de la commande en cours de traitement (les reponses n'y
+  // partent que la). Fonction inline -> une seule variable pour tout le fw.
+  inline uint8_t& curSink() { static uint8_t s = SINK_ALL; return s; }
+
+  // Copie de la verification de frequence du firmware (MQTT_Client.cpp).
+  inline bool isValidFrequency(uint8_t radio, float f) {
+    return !((radio == 1 && (f < 137 || f > 525))  ||
+             (radio == 2 && (f < 137 || f > 1020)) ||
+             (radio == 5 && (f < 410 || f > 810))  ||
+             (radio == 6 && (f < 150 || f > 960))  ||
+             (radio == 8 && (f < 2400 || f > 2500)));
+  }
+
+  inline void begin() {
+    Serial.println(F("@LOG GSLoraSat SerialBridge actif (off-grid) fw " GSL_FW_VERSION));
+    if (PacketStore::begin()) {
+      Serial.print(F("@LOG Journal flash : "));
+      Serial.print(PacketStore::count());
+      Serial.print(F(" paquet(s), boot #"));
+      Serial.println(PacketStore::bootId());
+    } else {
+      Serial.println(F("@LOG Journal flash INDISPONIBLE (LittleFS)"));
+    }
+  }
+
+  // Emission ATOMIQUE d'une ligne : construit toute la chaine (avec le '\n')
+  // puis l'ecrit en UN SEUL appel Serial.write(). Indispensable car le logger
+  // asynchrone de TinyGS (Log::consoleAsync, tourne sur l'autre coeur) peut
+  // s'inserer ENTRE deux Serial.print()/entre deux caracteres d'un
+  // serializeJson(doc, Serial) et corrompre la ligne @RX/@HELLO/@ACK.
+  inline void emitTo(uint8_t sink, const String& line) {
+    String out = line;
+    out += '\n';
+    if (sink != SINK_TCP)    Serial.write((const uint8_t*)out.c_str(), out.length());
+    if (sink != SINK_SERIAL) NetBridge::write(out);
+  }
+
+  // Diffusion (USB + TCP) : paquets recus, GPS.
+  inline void emitLine(const String& line) { emitTo(SINK_ALL, line); }
+
+  // Reponse a la commande en cours : seulement vers le canal demandeur.
+  inline void reply(const String& line) { emitTo(curSink(), line); }
+
+  inline void replyLog(const String& text) {
+    String s = F("@LOG ");
+    s += text;
+    reply(s);
+  }
+
+  inline void ack(const char* cmd, int result) {
+    String s = F("@ACK {\"cmd\":\"");
+    s += cmd;
+    s += F("\",\"result\":");
+    s += result;
+    s += '}';
+    reply(s);
+  }
+
+  // ====================================================================
+  //  Station -> Application
+  // ====================================================================
+  inline void sendRx(const String& dataB64) {
+    ConfigManager& cfg = ConfigManager::getInstance();
+    DynamicJsonDocument doc(1280 + dataB64.length());   // +128 : champs
+                                                    // clock / mono_usec
+                                                    // +128 : seq/boot/up_ms
+    // Identite du paquet dans le journal : EN TETE du document, pour que
+    // PacketStore la relise sans decoder tout le JSON.
+    bool valid = !status.lastPacketInfo.crc_error;
+    uint32_t seq = valid ? PacketStore::nextSeq() : 0;
+    if (valid) doc["seq"] = seq;
+    doc["boot"]  = PacketStore::bootId();
+    doc["up_ms"] = (uint32_t) millis();
+    JsonArray loc = doc.createNestedArray("station_location");
+    loc.add(cfg.getLatitude());
+    loc.add(cfg.getLongitude());
+    doc["mode"]             = status.modeminfolastpckt.modem_mode;
+    doc["frequency"]        = status.modeminfolastpckt.frequency;
+    doc["frequency_offset"] = status.modeminfolastpckt.freqOffset;
+    if (status.lastPacketInfo.freqDoppler != 0)
+      doc["f_doppler"]      = status.lastPacketInfo.freqDoppler;
+    doc["satellite"]        = status.modeminfolastpckt.satellite;
+    if (strcmp(status.modeminfolastpckt.modem_mode, "LoRa") == 0) {
+      doc["sf"]  = status.modeminfolastpckt.sf;
+      doc["cr"]  = status.modeminfolastpckt.cr;
+      doc["bw"]  = status.modeminfolastpckt.bw;
+      doc["iIQ"] = status.modeminfolastpckt.iIQ;
+    } else {
+      doc["bitrate"] = status.modeminfolastpckt.bitrate;
+      doc["freqdev"] = status.modeminfolastpckt.freqDev;
+      doc["rxBw"]    = status.modeminfolastpckt.bw;
+    }
+    doc["rssi"]            = status.lastPacketInfo.rssi;
+    doc["snr"]             = status.lastPacketInfo.snr;
+    doc["frequency_error"] = status.lastPacketInfo.frequencyerror;
+    // HORODATAGE : ne rien annoncer plutot qu'annoncer faux.
+    //
+    // Hors ligne il n'y a pas de NTP. Sur le T-Beam le GPS cale l'horloge
+    // (GpsBridge::syncClock), mais sur le Heltec V3 il n'y a pas de GPS du
+    // tout : time(NULL) rend alors les SECONDES DEPUIS L'ALLUMAGE, et
+    // lastPacketInfo.unix_time vaut par exemple 3051. Cette valeur est
+    // positive et ressemble a une date : cote application elle a ete prise
+    // pour le 1er janvier 1970, et tout le modele Doppler s'est retrouve
+    // evalue 56 ans dans le passe.
+    //
+    // On emet donc 0 quand l'horloge n'est pas calee, et un drapeau explicite.
+    // L'application peut alors horodater a la reception en connaissance de
+    // cause, au lieu d'etre trompee par un nombre plausible.
+    const time_t OFFGRID_EPOCH_MIN = 1735689600;   // 2025-01-01, comme GpsBridge
+    bool clockOk = (status.lastPacketInfo.unix_time >= OFFGRID_EPOCH_MIN);
+    doc["clock"]           = clockOk ? "ok" : "unset";
+    doc["unix_GS_time"]    = clockOk ? status.lastPacketInfo.unix_time : 0;
+    doc["usec_time"]       = clockOk ? status.lastPacketInfo.usec_time : 0;
+    // Le compteur monotone reste utile : il date les paquets les uns par
+    // rapport aux autres a la microseconde, meme sans horloge absolue.
+    if (!clockOk) doc["mono_usec"] = status.lastPacketInfo.usec_time;
+    doc["crc_error"]       = status.lastPacketInfo.crc_error;
+    doc["data"]            = dataB64;
+    doc["NORAD"]           = status.modeminfolastpckt.NORAD;
+    doc["az"]              = status.tle.dSatAZ;
+    doc["el"]              = status.tle.dSatEL;
+
+    // Serialisation en memoire PUIS emission atomique (anti-entrelacement).
+    String js;
+    serializeJson(doc, js);
+    // Journal flash : seulement les paquets VALIDES (un CRC faux n'a aucune
+    // valeur pour le Doppler et chasserait les bons paquets de la flash).
+    if (valid) PacketStore::append(js, seq);
+    String out = F("@RX ");
+    out += js;
+    emitLine(out);
+  }
+
+  inline void sendHello() {
+    ConfigManager& cfg = ConfigManager::getInstance();
+    StaticJsonDocument<640> doc;
+    JsonArray loc = doc.createNestedArray("station_location");
+    loc.add(cfg.getLatitude());
+    loc.add(cfg.getLongitude());
+    doc["tx"]      = cfg.getAllowTx();
+    doc["version"] = status.version;
+    doc["sat"]     = status.modeminfo.satellite;
+    // Carte reelle de la station : index (enum ConfigManager) + cible firmware,
+    // pour que l'app AFFICHE la bonne carte (les index different selon le fw).
+    doc["board"]   = cfg.getBoard();
+    doc["name"]    = cfg.getThingName();   // nom station (NVS) -> prerempli dans l'app
+#if defined(CONFIG_IDF_TARGET_ESP32S3)
+    doc["fw"]      = "heltec-s3";
+#else
+    doc["fw"]      = "tbeam";
+#endif
+    doc["gsl_fw"]  = GSL_FW_VERSION;
+    // Journal flash et liaison Wi-Fi : l'app sait ce qu'elle peut demander.
+    JsonObject lg  = doc.createNestedObject("log");
+    lg["ok"]       = PacketStore::ready();
+    lg["count"]    = PacketStore::count();
+    lg["first"]    = PacketStore::firstSeq();
+    lg["last"]     = PacketStore::lastSeq();
+    lg["boot"]     = PacketStore::bootId();
+    doc["up_ms"]   = (uint32_t) millis();
+    doc["tcp"]     = GSL_TCP_PORT;
+    String ip = NetBridge::ip();
+    if (ip.length()) doc["ip"] = ip;
+    String out = F("@HELLO ");
+    serializeJson(doc, out);
+    reply(out);
+  }
+
+  // ====================================================================
+  //  Journal flash : !LOGINFO / !LOGDUMP [seq] / !LOGSTOP / !LOGCLR
+  //
+  //  @LOGBEGIN {"count":N,"from":S,"boot":B,"up_ms":M,"clock":"ok|unset",
+  //             "unix":T}      (unix seulement si l'horloge est calee)
+  //  @LOGREC   <json>          un paquet, document identique a la ligne @RX
+  //  @LOGEND   {"sent":n,"last":S}
+  //
+  //  La relecture est INCREMENTALE et non bloquante : quelques lignes par
+  //  tour de loop(), la station continue d'ecouter pendant ce temps.
+  // ====================================================================
+  struct Dump {
+    bool     active = false;
+    uint8_t  sink   = SINK_SERIAL;
+    uint8_t  phase  = 0;        // 0 = fichier ancien, 1 = courant, 2 = fini
+    uint32_t from   = 0;
+    uint32_t sent   = 0;
+    uint32_t last   = 0;
+    File     f;
+  };
+  inline Dump& dump() { static Dump d; return d; }
+
+  inline void logInfo() {
+    StaticJsonDocument<320> d;
+    d["ok"]       = PacketStore::ready();
+    d["count"]    = PacketStore::count();
+    d["first"]    = PacketStore::firstSeq();
+    d["last"]     = PacketStore::lastSeq();
+    d["boot"]     = PacketStore::bootId();
+    d["up_ms"]    = (uint32_t) millis();
+    d["fs_total"] = (uint32_t) PacketStore::fsTotal();
+    d["fs_used"]  = (uint32_t) PacketStore::fsUsed();
+    d["dumping"]  = dump().active;
+    String out = F("@LOGINFO ");
+    serializeJson(d, out);
+    reply(out);
+  }
+
+  inline void dumpFinish() {
+    Dump& D = dump();
+    if (D.f) D.f.close();
+    String out = F("@LOGEND {\"sent\":");
+    out += D.sent;
+    out += F(",\"last\":");
+    out += D.last;
+    out += '}';
+    emitTo(D.sink, out);
+    D.active = false;
+  }
+
+  inline void dumpStart(const String& arg) {
+    Dump& D = dump();
+    if (D.active) dumpFinish();
+    if (!PacketStore::ready()) { ack("logdump", -1); return; }
+    D.active = true;
+    D.sink   = curSink() == SINK_ALL ? SINK_SERIAL : curSink();
+    D.phase  = 0;
+    D.from   = (uint32_t) arg.toInt();
+    D.sent   = 0;
+    D.last   = 0;
+    StaticJsonDocument<256> d;
+    d["count"] = PacketStore::count();
+    d["from"]  = D.from;
+    d["boot"]  = PacketStore::bootId();
+    d["up_ms"] = (uint32_t) millis();
+    time_t now = time(nullptr);
+    bool clockOk = now >= (time_t)1735689600;      // 2025-01-01
+    d["clock"] = clockOk ? "ok" : "unset";
+    if (clockOk) d["unix"] = (uint32_t) now;
+    String out = F("@LOGBEGIN ");
+    serializeJson(d, out);
+    emitTo(D.sink, out);
+  }
+
+  inline void dumpStep() {
+    Dump& D = dump();
+    if (!D.active) return;
+    for (int n = 0; n < 6; n++) {
+      if (!D.f) {
+        if (D.phase >= 2) { dumpFinish(); return; }
+        const char* path = (D.phase == 0) ? PacketStore::F_OLD : PacketStore::F_CUR;
+        D.phase++;
+        if (LittleFS.exists(path)) D.f = LittleFS.open(path, "r");
+        continue;
+      }
+      if (!D.f.available()) { D.f.close(); continue; }
+      String line = D.f.readStringUntil('\n');
+      line.trim();
+      if (!line.length() || line[0] != '{') continue;
+      int p = line.indexOf("\"seq\":");
+      uint32_t seq = (p >= 0 && p < 40) ? (uint32_t) line.substring(p + 6).toInt() : 0;
+      if (seq && seq < D.from) continue;
+      String out = F("@LOGREC ");
+      out += line;
+      emitTo(D.sink, out);
+      D.sent++;
+      if (seq > D.last) D.last = seq;
+    }
+  }
+
+  // ====================================================================
+  //  !TUNE : reconfiguration DIRECTE de la radio (logique de commandBegine)
+  //  {"mode":"LoRa","sat":"Norbi","NORAD":46494,"freq":436.703,"bw":250,
+  //   "sf":10,"cr":5,"sw":18,"pwr":5,"pl":8,"cl":120,"gain":0,"crc":true,"fldro":1}
+  // ====================================================================
+  inline void handleTune(const String& payload) {
+    Radio& radio = Radio::getInstance();
+    StaticJsonDocument<768> doc;
+    if (deserializeJson(doc, payload) || !doc.containsKey("mode")) {
+      replyLog(F("ERREUR: config modem invalide (!TUNE ignore)"));
+      ack("tune", -1);
+      return;
+    }
+    board_t board;
+    if (!ConfigManager::getInstance().getBoardConfig(board)) { ack("tune", -2); return; }
+    float freq = doc["freq"] | 0.0f;
+    if (!isValidFrequency(board.L_radio, freq)) {
+      replyLog(F("ERREUR: frequence invalide (!TUNE ignore)"));
+      ack("tune", -3);
+      return;
+    }
+
+    radio.clearPacketReceivedAction();
+    radio.disableInterrupt();
+
+    ModemInfo& m = status.modeminfo;
+    const char* mode = doc["mode"].as<const char*>();
+    strncpy(m.modem_mode, mode ? mode : "LoRa", sizeof(m.modem_mode) - 1);
+    m.modem_mode[sizeof(m.modem_mode) - 1] = '\0';
+    strncpy(m.satellite, doc["sat"] | "Manual", sizeof(m.satellite) - 1);
+    m.satellite[sizeof(m.satellite) - 1] = '\0';
+    m.NORAD = doc["NORAD"] | 0;
+
+    if (strcmp(m.modem_mode, "LoRa") == 0) {
+      m.frequency      = freq;
+      m.bw             = doc["bw"]   | 125.0f;
+      m.sf             = doc["sf"]   | 11;
+      m.cr             = doc["cr"]   | 5;
+      m.sw             = doc["sw"]   | 18;
+      m.power          = doc["pwr"]  | 14;
+      m.preambleLength = doc["pl"]   | 8;
+      m.gain           = doc["gain"] | 0;
+      m.crc            = doc["crc"]  | true;
+      m.fldro          = doc["fldro"]| 1;
+      m.iIQ            = doc["iIQ"]  | false;
+      m.len            = doc["len"]  | 0;
+    } else {
+      m.frequency      = freq;
+      m.bw             = doc["bw"]  | 125.0f;
+      m.bitrate        = doc["br"]  | 9.6f;
+      m.freqDev        = doc["fd"]  | 5.0f;
+      m.power          = doc["pwr"] | 14;
+      m.preambleLength = doc["pl"]  | 8;
+      m.len            = doc["len"] | 0;
+    }
+
+    m.tle[0] = 0;
+    status.tle.freqDoppler = 0;
+    status.tle.new_freqDoppler = 0;
+
+    int16_t r = radio.begin();     // applique reellement la nouvelle config
+    radio.enableInterrupt();
+
+    // (Optionnel) persister pour reecouter ce satellite apres coupure secteur :
+    // ConfigManager::getInstance().setModemStartup(payload.c_str());
+
+    replyLog(String(F("Modem reconfigure -> ")) + m.satellite + F(" @ ") +
+             String(m.frequency, 4) + F(" MHz"));
+    ack("tune", r);
+  }
+
+  inline void handleSat(const String& payload) {
+    StaticJsonDocument<128> d;
+    if (deserializeJson(d, payload)) { ack("sat", -1); return; }
+    strncpy(status.modeminfo.satellite, d[0] | "Manual",
+            sizeof(status.modeminfo.satellite) - 1);
+    status.modeminfo.satellite[sizeof(status.modeminfo.satellite) - 1] = '\0';
+    status.modeminfo.NORAD = d[1] | 0;
+    replyLog(String(F("Satellite ecoute : ")) + status.modeminfo.satellite);
+    ack("sat", 0);
+  }
+
+  inline void handleFreq(const String& payload) {
+    Radio& radio = Radio::getInstance();
+    radio.remote_freq((char*)payload.c_str(), payload.length());
+    ack("freq", 0);
+  }
+
+  // !MAP <x>,<y> : position pixel du satellite sur la carte OLED (0..127, 0..63).
+  // Calculee par GSLoraSat (SGP4) puis projetee ; "0,0" = pas de position.
+  inline void handleMap(const String& payload) {
+    int comma = payload.indexOf(',');
+    if (comma < 0) { status.satPos[0] = 0; status.satPos[1] = 0; return; }
+    status.satPos[0] = payload.substring(0, comma).toFloat();
+    status.satPos[1] = payload.substring(comma + 1).toFloat();
+  }
+
+  inline void handleTx(const String& payload) {
+    Radio& radio = Radio::getInstance();
+    String hex = payload; hex.trim();
+    size_t n = hex.length() / 2;
+    static uint8_t buf[256];
+    if (n > sizeof(buf)) n = sizeof(buf);
+    for (size_t i = 0; i < n; i++)
+      buf[i] = (uint8_t) strtol(hex.substring(i * 2, i * 2 + 2).c_str(), nullptr, 16);
+    int16_t r = radio.sendTx(buf, n);
+    ack("tx", r);
+  }
+
+  // !CFG <json> : configure la station SANS WiFi, puis sauvegarde (NVS).
+  //   {"board":0,"lat":"48.850","lon":"2.350","name":"F1GBD",
+  //    "tx":true,"boardtpl":"","reboot":true}
+  //   board : index carte (ESP32-S3 : 0=Heltec V3). reboot : redemarre si true.
+  inline void handleCfg(const String& payload) {
+    ConfigManager& cfg = ConfigManager::getInstance();
+    StaticJsonDocument<512> d;
+    if (deserializeJson(d, payload)) { ack("cfg", -1); return; }
+    if (d.containsKey("board"))    cfg.setBoard((uint8_t)(d["board"] | 0));
+    if (d.containsKey("boardtpl")) cfg.setBoardTemplate(d["boardtpl"] | "");
+    if (d.containsKey("lat"))      cfg.setLat(d["lat"] | "0.000");
+    if (d.containsKey("lon"))      cfg.setLon(d["lon"] | "-0.000");
+    if (d.containsKey("name"))     cfg.setName(d["name"] | "My TinyGS");
+    if (d.containsKey("tx"))       cfg.setAllowTx(d["tx"] | false);
+    replyLog(F("Configuration station mise a jour (sauvegardee)"));
+    ack("cfg", 0);
+    if (d["reboot"] | false) {
+      replyLog(F("reboot apres configuration"));
+      delay(200);
+      ESP.restart();
+    }
+  }
+
+  // ====================================================================
+  //  Application -> Station : dispatch (SerialBridge = SEUL lecteur serie)
+  // ====================================================================
+  inline void handleCommand(const String& line) {
+    Radio& radio = Radio::getInstance();
+    if      (line.startsWith("!TUNE ")) handleTune(line.substring(6));
+    else if (line.startsWith("!SAT "))  handleSat(line.substring(5));
+    else if (line.startsWith("!FREQ ")) handleFreq(line.substring(6));
+    else if (line.startsWith("!TX "))   handleTx(line.substring(4));
+    else if (line.startsWith("!CFG "))  handleCfg(line.substring(5));
+    else if (line.startsWith("!MAP "))  handleMap(line.substring(5));
+    else if (line.startsWith("!PING"))  sendHello();
+    else if (line.startsWith("!LOGINFO")) logInfo();
+    else if (line.startsWith("!LOGDUMP")) dumpStart(line.length() > 8 ? line.substring(9) : String(""));
+    else if (line.startsWith("!LOGSTOP")) { if (dump().active) dumpFinish(); ack("logstop", 0); }
+    else if (line.startsWith("!LOGCLR"))  {
+      if (dump().active) dumpFinish();
+      PacketStore::clear();
+      replyLog(F("Journal flash efface"));
+      ack("logclr", 0);
+    }
+    // NB : commandes console d'origine (!b/!e/!p) volontairement RETIREES.
+    // Sur les cartes a rebouclage TX->RX, la station relisait sa propre sortie
+    // "!e"/"!b" et se reinitialisait en boucle. L'app utilise !CFG pour rebooter.
+    else replyLog(F("Commande inconnue"));
+  }
+
+  inline void loop() {
+    while (Serial.available()) {
+      char c = (char) Serial.read();
+      if (c == '\n') {
+        rxLine.trim();
+        if (rxLine.length() && rxLine[0] == '!') {
+          curSink() = SINK_SERIAL;
+          handleCommand(rxLine);
+          curSink() = SINK_ALL;
+        }
+        rxLine = "";
+      } else if (c != '\r') {
+        rxLine += c;
+        if (rxLine.length() > 700) rxLine = "";   // garde-fou anti-debordement
+      }
+    }
+
+    // Pont TCP Wi-Fi : meme protocole, meme dispatch.
+    NetBridge::service();
+    if (NetBridge::takeFresh()) {
+      curSink() = SINK_TCP;
+      sendHello();
+      curSink() = SINK_ALL;
+    }
+    String tl;
+    while (NetBridge::readLine(tl)) {
+      if (tl.length() && tl[0] == '!') {
+        curSink() = SINK_TCP;
+        handleCommand(tl);
+        curSink() = SINK_ALL;
+      }
+    }
+
+    dumpStep();
+  }
+
+} // namespace SerialBridge
+#endif
